# Copie para .env.local e substitua os valores de exemplo.
POSTGRES_USER=qrcode
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_DB=qrcode
POSTGRES_PORT=5437
DATABASE_URL=postgresql://qrcode:troque-por-uma-senha-local@127.0.0.1:5437/qrcode
# Usada somente pelo container da aplicação; para banco próprio, configure a URL dele.
DOCKER_DATABASE_URL=postgresql://qrcode:troque-por-uma-senha-local@db:5432/qrcode
APP_URL=http://localhost:3000
PDF_PATH=./docs/Guia_MEI_2026.pdf
PDF_DOWNLOAD_NAME=Guia_MEI_2026.pdf
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
DOWNLOAD_COOKIE_SECRET=substitua-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
