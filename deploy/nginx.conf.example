# Inclua as zonas no bloco http do Nginx. Ajuste o limite ao público esperado:
# visitantes de um evento podem compartilhar o mesmo IP de saída.
limit_req_zone $binary_remote_addr zone=pdf_signup:10m rate=30r/m;

server {
    listen 80;
    server_name material.seudominio.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name material.seudominio.com;
    ssl_certificate /etc/letsencrypt/live/material.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/material.seudominio.com/privkey.pem;
    client_max_body_size 8k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /api/cadastros {
        limit_req zone=pdf_signup burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }
}
